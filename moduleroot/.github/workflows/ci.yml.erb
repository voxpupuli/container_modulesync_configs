---
# Managed by modulesync - DO NOT EDIT
# https://voxpupuli.org/docs/updating-files-managed-with-modulesync/

name: 🚦 CI

# yamllint disable-line rule:truthy
on:
  pull_request:
    branches:
<%- @configs['main_branches'].each do |branch| -%>
      - <%= branch %>
<%- end -%>
  workflow_dispatch:

concurrency:
  group: ci-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
<%- if @configs['matrix_command'] -%>
  setup-matrix:
    name: Set up build matrix
    runs-on: ubuntu-latest
    outputs:
      build-matrix: ${{ steps.build-matrix.outputs.build-matrix }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v7
<%- if @configs['matrix_requires_yq'] -%>

      - name: Install yq
        uses: dcarbone/install-yq-action@v1.3.1
<%- end -%>

      - name: Generate build matrix
        id: build-matrix
        run: echo "build-matrix=$(<%= @configs['matrix_command'] %>)" >> "$GITHUB_OUTPUT"

<%- end -%>
<%- if @configs['general_ci_scan_dir'] -%>
  general-ci:
    name: General CI
    permissions:
      actions: read
      contents: read
      security-events: write
    uses: voxpupuli/crafty/.github/workflows/general_ci.yaml@main
    with:
      shellcheck_scan_dir: '<%= @configs['general_ci_scan_dir'] %>'

<%- end -%>
  build-container:
    name: <%= @configs['build_job_name'] %>
    runs-on: <%= @configs['build_runner'] %>
<%- if @configs['matrix_command'] -%>
    needs:
      - setup-matrix
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.setup-matrix.outputs.build-matrix) }}
<%- end -%>
    permissions:
      actions: read
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v7

      - name: Build image
        uses: docker/build-push-action@v7
        with:
          context: <%= @configs['build_context'] %>
          file: <%= @configs['build_file'] %>
          tags: '<%= @configs['image_tag'] %>'
          push: false
<%- if @configs['build_platforms'] -%>
          platforms: <%= @configs['build_platforms'] %>
<%- end -%>
<%- unless @configs['build_args'].empty? -%>
          build-args: |
<%- @configs['build_args'].each do |argument| -%>
            <%= argument %>
<%- end -%>
<%- end -%>
<%- if @configs['test_repository'] -%>

      - name: Checkout test repository
        uses: actions/checkout@v7
        with:
          repository: <%= @configs['test_repository'] %>
<%- end -%>
<%- unless @configs['test_commands'].empty? -%>

      - name: Test image
        run: |
<%- @configs['test_commands'].each do |command| -%>
          <%= command %>
<%- end -%>
<%- end -%>
<%- unless @configs['post_test_commands'].empty? -%>

      - name: Run post-test diagnostics
        run: |
<%- @configs['post_test_commands'].each do |command| -%>
          <%= command %>
<%- end -%>
<%- end -%>

  tests:
    name: Test suite
    if: always()
    needs:
<%- if @configs['matrix_command'] -%>
      - setup-matrix
<%- end -%>
<%- if @configs['general_ci_scan_dir'] -%>
      - general-ci
<%- end -%>
      - build-container
    runs-on: ubuntu-24.04
    steps:
      - name: Verify required jobs
        uses: re-actors/alls-green@release/v1
        with:
          jobs: ${{ toJSON(needs) }}
<%- if @configs['dependabot_automerge'] -%>

  dependabot:
    name: Dependabot auto-merge
    if: github.actor == 'dependabot[bot]' && github.event_name == 'pull_request'
    needs:
      - tests
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
    steps:
      - name: Enable auto-merge for Dependabot PR
        env:
          GH_TOKEN: ${{ github.token }}
          PR_URL: ${{ github.event.pull_request.html_url }}
        run: gh pr merge --auto --merge "$PR_URL"
<%- end -%>
