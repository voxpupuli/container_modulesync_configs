---
# Managed by modulesync - DO NOT EDIT
# https://voxpupuli.org/docs/updating-files-managed-with-modulesync/

name: 🕵️ Security Scanning

# yamllint disable-line rule:truthy
on:
  push:
    branches:
<%- @configs['main_branches'].each do |branch| -%>
      - <%= branch %>
<%- end -%>
  pull_request:
    branches:
<%- @configs['main_branches'].each do |branch| -%>
      - <%= branch %>
<%- end -%>
  workflow_dispatch:

concurrency:
  group: security-scanning-${{ github.event.pull_request.number || github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
<%- if @configs['matrix_command'] -%>
  setup-matrix:
    name: Set up build matrix
    runs-on: ubuntu-latest
    outputs:
      build-matrix: ${{ steps.build-matrix.outputs.build-matrix }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
<%- if @configs['matrix_requires_yq'] -%>

      - name: Install yq
        uses: dcarbone/install-yq-action@4075b4dca348d74bd83f2bf82d30f25d7c54539b # v1.3.1
<%- end -%>

      - name: Generate build matrix
        id: build-matrix
        run: echo "build-matrix=$(<%= @configs['matrix_command'] %>)" >> "$GITHUB_OUTPUT"

<%- end -%>
  scan-container:
    name: <%= @configs['scan_job_name'] %>
    runs-on: <%= @configs['build_runner'] %>
<%- if @configs['matrix_command'] -%>
    needs:
      - setup-matrix
    strategy:
      fail-fast: false
      matrix: ${{ fromJSON(needs.setup-matrix.outputs.build-matrix) }}
<%- end -%>
    permissions:
      actions: read
      contents: read
      security-events: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0

      - name: Build image
        uses: docker/build-push-action@53b7df96c91f9c12dcc8a07bcb9ccacbed38856a # v7.3.0
        with:
          context: <%= @configs['build_context'] %>
          file: <%= @configs['build_file'] %>
          tags: '<%= @configs['image_tag'] %>'
          load: true
          push: false
<%- if @configs['build_platforms'] -%>
          platforms: <%= @configs['build_platforms'] %>
<%- end -%>
<%- unless @configs['build_args'].empty? -%>
          build-args: |
<%- @configs['build_args'].each do |argument| -%>
            <%= argument %>
<%- end -%>
<%- end -%>

      - name: Scan image with Anchore Grype
        id: scan
        uses: anchore/scan-action@e1165082ffb1fe366ebaf02d8526e7c4989ea9d2 # v7.4.0
        with:
          image: '<%= @configs['image_tag'] %>'
          fail-build: <%= @configs['fail_build'] %>
<%- if @configs['severity_cutoff'] -%>
          severity-cutoff: <%= @configs['severity_cutoff'] %>
<%- end -%>

      - name: Inspect SARIF report
        run: jq . "${{ steps.scan.outputs.sarif }}"

      - name: Upload SARIF report
        uses: github/codeql-action/upload-sarif@e4fba868fa4b1b91e1fdab776edc8cfbe6e9fb81 # v4.37.3
        with:
          sarif_file: ${{ steps.scan.outputs.sarif }}
<%- if @configs['sarif_category'] -%>
          category: '<%= @configs['sarif_category'] %>'
<%- end -%>
